{
    "layer": "top",
    "position": "bottom",
    "height": 22,
    "spacing": 0,
    "modules-left": [
        "sway/workspaces",
        "sway/mode"
    ],
    "modules-right": [
        "temperature",
        "cpu",
        "memory",
        "disk",
        "network",
        "battery",
        "pulseaudio",
        "power-profiles-daemon",
        "clock",
        "tray"
    ],
    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "MODE: {}"
    },
    "temperature": {
        "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        "input-filename": "temp1_input",
        "critical-threshold": 85,
        "format": "T {temperatureC}°C",
        "tooltip-format": "CPU temperature: {temperatureC}°C"
    },
    "cpu": {
        "format": "CPU {usage}%",
        "tooltip": true
    },
    "memory": {
        "format": "MEM {percentage}%",
        "tooltip-format": "Memory: {used:0.1f} GiB used / {total:0.1f} GiB"
    },
    "disk": {
        "path": "/",
        "format": "DISK {free}",
        "tooltip-format": "Disk: {used} used / {total} total ({percentage_used}%)"
    },
    "network": {
        "format-wifi": "W {essid} {signalStrength}%",
        "format-ethernet": "E {ipaddr}",
        "format-linked": "{ifname} linked",
        "format-disconnected": "NET down",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\nGateway: {gwaddr}"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT {capacity}%",
        "format-charging": "BAT {capacity}% +",
        "format-plugged": "BAT {capacity}% AC",
        "format-full": "BAT full",
        "tooltip-format": "Battery: {capacity}%\n{timeTo}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇 MUTE",
        "format-icons": {
            "default": ["🔈", "🔉", "🔊"]
        },
        "scroll-step": 5,
        "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "on-click-right": "pavucontrol",
        "tooltip-format": "{desc}\nVolume: {volume}%"
    },
    "power-profiles-daemon": {
        "format": "{icon}",
        "tooltip": true,
        "tooltip-format": "Active power profile: {profile}\nDriver: {driver}",
        "format-icons": {
            "default": "🔋",
            "performance": "⚡",
            "balanced": "⚖️",
            "power-saver": "🌿"
        }
    },
    "clock": {
        "format": "{:%Y-%m-%d %I:%M %p}",
        "tooltip-format": "<big>{:%A, %B %d, %Y}</big>"
    },
    "tray": {
        "icon-size": 16,
        "spacing": 6
    }
}
