[user]
	email = combatburrito@gmail.com
	name = David Nunes-Childs
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[filter "codex-config"]
	clean = ~/.local/bin/codex-config-clean
	smudge = cat
	required = true
# Clone and fetch over HTTPS so a fresh machine needs no credentials,
# but push over SSH, which is how this account authenticates for writes.
# Applies to every github.com remote, submodules included.
[url "git@github.com:"]
	pushInsteadOf = https://github.com/
