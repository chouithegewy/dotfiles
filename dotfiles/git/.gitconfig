[user]
	email = combatburrito@gmail.com
	name = David Nunes-Childs
[credential]
	helper = cache
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[filter "codex-config"]
	clean = ~/.local/bin/codex-config-clean
	smudge = cat
	required = true
